{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/atelier",
      "destination": "/"
    },
    {
      "source": "/atelier/:path*",
      "destination": "/"
    },
    {
      "source": "/coeur-des-mielles",
      "destination": "/"
    },
    {
      "source": "/creations",
      "destination": "/"
    },
    {
      "source": "/creations/:path*",
      "destination": "/"
    },
    {
      "source": "/collections/:path*",
      "destination": "/"
    },
    {
      "source": "/la-maison",
      "destination": "/"
    },
    {
      "source": "/selection",
      "destination": "/"
    },
    {
      "source": "/collections",
      "destination": "/"
    },
    {
      "source": "/bijoux",
      "destination": "/"
    },
    {
      "source": "/bijoux/:path*",
      "destination": "/"
    },
    {
      "source": "/coeur-de-mielles",
      "destination": "/"
    },
    {
      "source": "/la-marque",
      "destination": "/"
    },
    {
      "source": "/le-groupe",
      "destination": "/"
    },
    {
      "source": "/jinoria",
      "destination": "/"
    },
    {
      "source": "/atelier-de-design",
      "destination": "/"
    },
    {
      "source": "/confidentialite",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/coeur-des-mielles",
      "destination": "/coeur-de-mielles",
      "permanent": true
    },
    {
      "source": "/le-groupe",
      "destination": "/jinoria",
      "permanent": true
    }
  ]
}
