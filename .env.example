SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=atelier-private
ATELIER_PUBLISH_KEY=
PUBLIC_PORTAL_URL=https://votre-galerie.vercel.app
# The Vercel Supabase integration supplies the three SUPABASE_* values above.
# No duplicate VITE_* variables are required. Legacy anon/service_role keys remain supported.
# Optional overrides for existing Vite deployments:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional public contact destination for the showcase
VITE_CONTACT_EMAIL=

# Optional external JINORIA website (full HTTPS URL)
VITE_JINORIA_URL=https://jinoria.com/
